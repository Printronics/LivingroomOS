#!/bin/sh
# livingroomos-session – starts the labwc compositor and restarts it after crashes.
# greetd runs initial_session only once per boot, so the restart loop is implemented here.
# After MAX_CRASHES crashes within WINDOW_S seconds, the script exits; greetd then shows the
# text login (default_session) instead of an endless restart loop.
set -u

LABWC_CONFIG_DIR=/opt/livingroomos/system/labwc
MAX_CRASHES=5
WINDOW_S=60

crashes=0
window_start=$(date +%s)

while :; do
    labwc -C "$LABWC_CONFIG_DIR"
    status=$?
    if [ "$status" -eq 0 ]; then
        exit 0          # normal exit (logout)
    fi
    now=$(date +%s)
    if [ $((now - window_start)) -gt "$WINDOW_S" ]; then
        window_start=$now
        crashes=0
    fi
    crashes=$((crashes + 1))
    echo "livingroomos-session: labwc exited with status $status (crash $crashes of $MAX_CRASHES)" >&2
    if [ "$crashes" -ge "$MAX_CRASHES" ]; then
        exit 1
    fi
    sleep 1
done
