#!/usr/bin/env python3
"""livingroomosctl – small command-line utility for keyboard shortcuts and systemd user units.

Communicates with the LivingroomOS backend over HTTP only on 127.0.0.1 (port from
LIVINGROOMOS_PORT, default 8750). It does not start programs and uses only the standard library.

  livingroomosctl home          stops the running app; the launcher becomes visible again
  livingroomosctl status        gibt den Status des Backends als JSON aus
  livingroomosctl wait [SEK]    waits (60 s by default) until the backend is ready

Exit codes: 0 success, 1 backend unreachable or error, 2 incorrect usage.
"""
from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request

# Environment proxy settings must never redirect loopback requests.
_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def base_url() -> str:
    return f"http://127.0.0.1:{int(os.environ.get('LIVINGROOMOS_PORT', '8750'))}"


def call(method: str, path: str, timeout: float = 3.0) -> dict:
    request = urllib.request.Request(
        base_url() + path,
        method=method,
        data=b"" if method == "POST" else None,
        headers={"X-LivingroomOS": "1"},  # required for write requests (backend CSRF protection)
    )
    with _OPENER.open(request, timeout=timeout) as response:
        return json.load(response)


def wait_ready(seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while True:
        try:
            if call("GET", "/api/v1/health", timeout=2).get("status") == "ok":
                return True
        except (OSError, ValueError):
            pass
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.5)


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] not in {"home", "status", "wait"} or len(args) > 2:
        print(__doc__, file=sys.stderr)
        return 2
    command = args[0]
    try:
        if command == "wait":
            seconds = float(args[1]) if len(args) == 2 else 60.0
            if wait_ready(seconds):
                return 0
            print("livingroomosctl: Backend did not become ready in time.", file=sys.stderr)
            return 1
        if len(args) != 1:
            print(__doc__, file=sys.stderr)
            return 2
        result = call("POST", "/api/v1/apps/stop") if command == "home" else call("GET", "/api/v1/apps/status")
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except ValueError:
        print("livingroomosctl: Invalid wait duration.", file=sys.stderr)
        return 2
    except urllib.error.HTTPError as exc:
        print(f"livingroomosctl: Backend meldet HTTP {exc.code}.", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"livingroomosctl: Backend is not reachable: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
