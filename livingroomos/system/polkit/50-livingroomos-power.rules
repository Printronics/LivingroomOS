// LivingroomOS: the dedicated kiosk account may request only local power actions.
polkit.addRule(function(action, subject) {
    if (subject.user === "livingroomos" &&
        ["org.freedesktop.login1.reboot",
         "org.freedesktop.login1.reboot-multiple-sessions",
         "org.freedesktop.login1.power-off",
         "org.freedesktop.login1.power-off-multiple-sessions"].indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
