[Unit]
Description=LivingroomOS Backend (FastAPI auf 127.0.0.1:8750)
Documentation=file:///opt/livingroomos/ARCHITECTURE.md

[Service]
Type=simple
WorkingDirectory=/opt/livingroomos/backend
# Program code under /opt is root-owned and not writable; do not write bytecode.
Environment=PYTHONDONTWRITEBYTECODE=1
# Configuration is stored in the user's home directory because the backend writes back the "ui" section.
Environment=LIVINGROOMOS_CONFIG=%h/.config/livingroomos/settings.json
ExecStart=/opt/livingroomos/run.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
# Files created by child processes are private. For additional hardening (ProtectSystem, etc.), see docs/SECURITY.md, Section 6.
# Enable only after testing with Google Chrome because restrictions are inherited by apps.
UMask=0077
NoNewPrivileges=yes
# Default KillMode=control-group: if the backend is stopped or crashes, the running app also exits,
# and the launcher becomes visible again. To keep the app running and have it adopted by the new backend,
# set KillMode=process (see docs/SECURITY.md).
