<?xml version="1.0"?>
<!--
  LivingroomOS – labwc-Konfiguration (Kiosk). UNGETESTET auf echter Hardware, Syntax nach labwc-config(5).

  There is intentionally no <default />: this disables Alt+Tab, Alt+F4, the window menu, and switching to
  virtual consoles. This prevents accidental use, not attackers with physical access (see ARCHITECTURE.md).
  Vollbild erzwingen die Apps selbst (Kiosk-Option bzw. Vollbild-Option).
-->
<labwc_config>
  <windowRules>
    <windowRule identifier="*">
      <serverDecoration>no</serverDecoration>
    </windowRule>
  </windowRules>

  <keyboard>
    <!-- Remote-control Home button: stop the running app and show the launcher again. -->
    <keybind key="XF86HomePage">
      <action name="Execute" command="/opt/livingroomos/system/bin/livingroomosctl home" />
    </keybind>
    <!-- Keyboard fallback if the remote control does not send a Home key. -->
    <keybind key="C-A-Home">
      <action name="Execute" command="/opt/livingroomos/system/bin/livingroomosctl home" />
    </keybind>
  </keyboard>
</labwc_config>
