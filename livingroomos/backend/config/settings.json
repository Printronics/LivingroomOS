{
  "server": {
    "data_dir": "~/.local/share/livingroomos",
    "startup_grace_s": 1.0,
    "stop_timeout_s": 5.0,
    "trusted_bin_dirs": [
      "/usr/local/bin",
      "/usr/bin",
      "/opt"
    ],
    "return_to_launcher_command": null
  },
  "ui": {
    "clock_24h": true,
    "show_clock": true,
    "tile_size": "normal",
    "reduce_motion": false,
    "confirm_power": true,
    "show_app_subtitles": true
  },
  "apps": [
    {
      "id": "demo",
      "title": "Demo-App",
      "subtitle": "Test process, runs for 10 minutes",
      "icon": "D",
      "color": "#2f9e6f",
      "command": [
        "{python}",
        "-c",
        "import time; time.sleep(600)"
      ],
      "category": "debug"
    },
    {
      "id": "demo-crash",
      "title": "Crash Test",
      "subtitle": "Exits after 3 seconds with an error",
      "icon": "!",
      "color": "#c98a1b",
      "command": [
        "{python}",
        "-c",
        "import sys, time; time.sleep(3); sys.exit(3)"
      ],
      "category": "debug"
    }
  ]
}
